# Sao chép file này thành .env (hoặc tự set biến môi trường tương ứng) rồi chỉnh lại
# trước khi deploy thật — các giá trị mặc định trong app/config.py chỉ để chạy demo.

# Khoá ký JWT — BẮT BUỘC đổi khi deploy thật (vd. openssl rand -hex 32)
KV_JWT_SECRET=doi-chuoi-nay-truoc-khi-deploy-that

# Số phút token còn hiệu lực (mặc định 7 ngày = 10080 phút)
KV_TOKEN_EXPIRE_MINUTES=10080

# Chuỗi kết nối PostgreSQL — BẮT BUỘC (không có giá trị mặc định). Lấy từ Render:
# Dashboard -> database Postgres -> "External Database URL" (chạy local/máy ngoài Render) hoặc
# "Internal Database URL" (chỉ dùng được khi backend cũng deploy trên Render, cùng region — nhanh
# hơn và miễn phí băng thông, nhưng KHÔNG resolve được từ máy cá nhân).
# Thường cần thêm ?sslmode=require ở cuối nếu dùng External URL mà provider bắt buộc SSL.
KV_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Thư mục chứa repo frontend KiMViE-Website, để backend mount làm trang tĩnh.
# Mặc định giả sử 2 repo nằm cạnh nhau: .../Github/KiMiE-Backend và .../Github/KiMViE-Website
KV_FRONTEND_DIR=../KiMViE-Website
